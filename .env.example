# Copy to .env (or set these in your host's dashboard) and restart the server.

# Port the server listens on.
PORT=3000

# Who is allowed to create, edit and delete events.
# Format: name:password, separated by commas or newlines.
# Everyone else can still open the shared link and sign up for events.
CG_ORGANIZERS=brian:choose-a-long-passphrase,jamie:another-long-passphrase

# Name shown in the header of the calendar.
CG_APP_NAME=Community Group Calendar

# Optional: set to 1 when running behind an HTTPS proxy that does not
# forward X-Forwarded-Proto, so session cookies are marked Secure.
CG_FORCE_SECURE_COOKIES=0
